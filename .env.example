# Copy this file to `.env` (same folder) and fill in your own values. `.env` is never committed.

# --- Web (PHP) ---
APP_URL=http://localhost/binbuddy
DB_HOST=localhost
DB_NAME=waste_system
DB_USER=root
DB_PASSWORD=********

# Admin login for the back office (leave empty to disable admin login)
ADMIN_EMAIL=
ADMIN_PASSWORD=********

# Gmail SMTP for "forgot password" (use a Gmail App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=********
SMTP_FROM=

# AI image analysis fallback (Google Gemini)
GEMINI_API_KEY=********

# FastAPI model server
API_BASE_URL=http://127.0.0.1:8000
