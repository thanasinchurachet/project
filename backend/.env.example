# Copy to backend/.env and fill in. Never commit the real file.

GOOGLE_MAPS_API_KEY=********
GEMINI_API_KEY=********

# Model weights (not in the repo — put best.pt under models/<version>/)
MODELS_DIR=../models
MODEL_PATH=../models/best.pt
LABELS_FILE=../models/labels.json

# Training pipeline (admin page "train model")
DATA_ROOT=../data/prepared
TRAIN_SCRIPT=train.py
ADMIN_TOKEN=********
FASTAPI_ADMIN_TOKEN=********
ADMIN_PANEL_URL=http://localhost/binbuddy/admin/train_model.php

# n8n webhook that sends the LINE message when training finishes (optional)
N8N_WEBHOOK_URL=********
